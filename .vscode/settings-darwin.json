{
    "cSpell.words": [
        "fyne"
    ],
    // Force cgo on for gopls. On macOS, gopls spins up extra windows/amd64 and
    // linux/amd64 views to type-check the *_windows.go / *_linux.go files; with
    // the default CGO_ENABLED=0 for cross targets, Fyne's OpenGL dependency
    // (github.com/go-gl/gl) has no eligible files and every Fyne import errors.
    "gopls": {
        "env": {
            "CGO_ENABLED": "1"
        }
    },
    "go.toolsEnvVars": {
        "CGO_ENABLED": "1"
    },
    "terminal.integrated.stickyScroll.enabled": false
}
